generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  password      String?
  name          String?
  role          String   @default("USER")
  emailVerified Boolean  @default(false)
  verificationCode String?
  verificationSentAt DateTime?
  sellerCode    String?
  city          String?
  address       String?
  phone         String?
  selectedMascot String?  @default("box")
  mascotNames    Json?     @default("{}")
  createdAt     DateTime @default(now())

  products       Product[]
  stores         Store[]
  carts          Cart[]
  paymentMethods PaymentMethod[]
  orders         Order[]
  sentMessages   Message[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  reviews         Review[]
  achievements   Achievement[]
  preferences    UserPreferences?
}

model Store {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  code           String   @unique
  userId         String?  @db.ObjectId
  user           User?    @relation(fields: [userId], references: [id])
  products       Product[]
  orderItems     OrderItem[]
  shippingZones  ShippingZone[]
  createdAt      DateTime @default(now())
}


model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  price     Float
  stock     Int
  categoryId String  @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])
  storeId    String   @db.ObjectId
  store      Store    @relation(fields: [storeId], references: [id])
  userId     String?  @db.ObjectId   // 🔹 opcional
  user       User?    @relation(fields: [userId], references: [id]) // 🔹 opcional
  description String?
  images      String[]
  cartItems   CartItem[]
  createdAt   DateTime @default(now())
  orderItemProducts OrderItemProduct[]
  conversations    Conversation[]
  reviews          Review[]
  priceHistory     PriceHistory[]
  freeShipping     Boolean  @default(false)
  originalPrice    Float?
  discountPct      Float?

  @@index([categoryId])
  @@index([storeId])
  @@index([userId])
}


model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  title     String
  price     Float
  quantity  Int
  image     String
  storeId   String?
  createdAt DateTime @default(now())

  @@index([cartId])
  @@index([productId])
}

model Order {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  userId           String      @db.ObjectId
  user             User        @relation(fields: [userId], references: [id])
  total            Float
  status           String      @default("pending")
  paymentStatus    String      @default("unpaid")

  // Relación con PaymentMethod
  paymentMethodId  String?     @db.ObjectId
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  paymentProof     String?
  paymentProofMime String?
  paidAt           DateTime?
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  customerAddress  String?
  orderNumber      String?
  orderItems       OrderItem[]
  createdAt        DateTime    @default(now())
  paymentVerifiedBy String?
  paymentVerifiedAt DateTime?
  proofUploadedBy   String?
  proofUploadedAt   DateTime?
  stockDeducted     Boolean   @default(false)
  deleted           Boolean   @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  deletedReason     String?
  refundStatus      String    @default("none")  // none | pending | processed

  // Envío
  shippingCost      Float     @default(0)
  shippingAddress   String?
  shippingCity      String?
  shippingDepartment String?
  shippingPostalCode String?
  trackingNumber    String?
  shippingStatus    String    @default("none")  // none | pending | shipped | in_transit | delivered
  shippingCarrier   String?
  shippedAt         DateTime?
  deliveredAt       DateTime?

  orderHistories OrderHistory[]

  @@index([userId])
  @@index([paymentMethodId])
}

model PaymentMethod {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])

  type       String
  phone      String?
  account    String?
  cci        String?
  qrImageUrl String?
  details    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]  // relación inversa
}




model OrderItem {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  storeId String @db.ObjectId
  store   Store  @relation(fields: [storeId], references: [id])

  paymentStatus String  @default("unpaid")
  paymentLink   String?

  items OrderItemProduct[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([storeId])
}



model OrderItemProduct {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  orderItemId String    @db.ObjectId
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  price    Float

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([productId])
}

model OrderHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  action    String
  byUserId  String?
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model VerificationCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  expires   DateTime
  createdAt DateTime @default(now())
}

model Conversation {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  buyerId     String    @db.ObjectId
  buyer       User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId    String    @db.ObjectId
  seller      User      @relation("SellerConversations", fields: [sellerId], references: [id])
  productId   String?   @db.ObjectId
  product     Product?  @relation(fields: [productId], references: [id])
  orderId     String?   @db.ObjectId
  lastMessage String?
  lastMessageAt DateTime?
  createdAt   DateTime  @default(now())
  messages    Message[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([buyerId, sellerId])
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id])
  text           String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  orderId    String   @db.ObjectId
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([orderId])
  @@unique([productId, userId, orderId])
}

model ShippingZone {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId      String   @db.ObjectId
  store        Store    @relation(fields: [storeId], references: [id])
  name         String
  department   String
  province     String?
  cost         Float
  estimatedDays Int     @default(3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Achievement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  type        String
  unlockedAt  DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

model PriceHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id])
  oldPrice    Float
  newPrice    Float
  changedAt   DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
}

model UserPreferences {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  theme       String   @default("default")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
